{
  "productId": "shipit-platform",
  "name": "ShipIt Platform",
  "version": "1.0.0",
  "description": "The ShipIt agentic engineering control plane: Flutter operator UI, Dart Serverpod control plane, worker fleet, and the packages they compose from.",
  "capabilities": [
    "backend",
    "web",
    "cli",
    "library"
  ],
  "environments": [
    {
      "name": "staging",
      "type": "custom",
      "config": {
        "deployment": "docker compose -f docker/compose.qa.yaml",
        "apiPort": 8180,
        "uiPort": 8081
      }
    },
    {
      "name": "production",
      "type": "custom",
      "config": {
        "deployment": "cloudbuild.release.yaml",
        "promotionAuthority": "human"
      }
    }
  ],
  "contracts": {
    "workItemCategories": [
      "feature"
    ],
    "designContract": {
      "requiredArtifacts": [
        "architecture-decision-record"
      ],
      "reviewers": [],
      "approvalThreshold": 1
    },
    "qaContract": {
      "gates": [
        {
          "gateId": "intake-structured-result-admitted",
          "type": "triage-classification-structure",
          "required": true,
          "config": {
            "sourceColumn": "agent_result.structuredResultJson",
            "requiredFields": [
              "classification",
              "status",
              "confidence",
              "suspectedCategory"
            ],
            "classificationEnum": "DefectClassification",
            "statusEnum": "DefectStatus",
            "evidenceTypes": [
              "triage_structured_result"
            ]
          }
        },
        {
          "gateId": "feature-change-committed",
          "type": "implementation-artifact-provenance",
          "required": true,
          "config": {
            "evidenceTypes": [
              "execution_delta",
              "committed_revision"
            ],
            "requireReadableDelta": true,
            "requireHeadMoved": true,
            "recordProducedRevision": true
          }
        },
        {
          "gateId": "feature-change-scope-confined",
          "type": "change-scope-confinement",
          "required": true,
          "config": {
            "evidenceTypes": [
              "committed_diff_paths"
            ],
            "ownedPathGlobs": [],
            "forbiddenPathGlobs": [],
            "pathSource": "git_diff_name_only"
          }
        },
        {
          "gateId": "feature-declared-checks-executed",
          "type": "declared-validation-outcome",
          "required": true,
          "config": {
            "evidenceTypes": [
              "platform_verification"
            ],
            "requireCheckNames": [
              "dart_format_repo_root",
              "dart_analyze_packages_platform_contracts",
              "dart_analyze_packages_workflow_engine",
              "dart_analyze_packages_workflow_store",
              "dart_analyze_packages_agent_runtime",
              "dart_analyze_packages_worker_protocol",
              "dart_analyze_packages_qa_orchestration",
              "dart_analyze_packages_deployment_protocol",
              "dart_analyze_packages_execution_coordinator",
              "dart_analyze_packages_worker_runtime",
              "dart_analyze_packages_scheduler",
              "dart_analyze_packages_product_registry",
              "dart_analyze_packages_store_contract_tests",
              "dart_analyze_packages_control_plane_client",
              "dart_analyze_packages_design_governance",
              "dart_analyze_apps_server",
              "dart_analyze_apps_control_plane",
              "dart_test_packages_platform_contracts",
              "dart_test_packages_workflow_engine",
              "dart_test_packages_workflow_store",
              "dart_test_packages_agent_runtime",
              "dart_test_packages_worker_protocol",
              "dart_test_packages_qa_orchestration",
              "dart_test_packages_deployment_protocol",
              "dart_test_packages_execution_coordinator",
              "dart_test_packages_worker_runtime",
              "dart_test_packages_scheduler",
              "dart_test_packages_product_registry",
              "dart_test_packages_store_contract_tests",
              "dart_test_packages_design_governance",
              "server_unit_tests_runner",
              "flutter_test_apps_control_plane"
            ],
            "requireCommands": {
              "dart_format_repo_root": "dart format --output=none --set-exit-if-changed .",
              "dart_analyze_packages_platform_contracts": "dart analyze",
              "dart_analyze_packages_workflow_engine": "dart analyze",
              "dart_analyze_packages_workflow_store": "dart analyze",
              "dart_analyze_packages_agent_runtime": "dart analyze",
              "dart_analyze_packages_worker_protocol": "dart analyze",
              "dart_analyze_packages_qa_orchestration": "dart analyze",
              "dart_analyze_packages_deployment_protocol": "dart analyze",
              "dart_analyze_packages_execution_coordinator": "dart analyze",
              "dart_analyze_packages_worker_runtime": "dart analyze",
              "dart_analyze_packages_scheduler": "dart analyze",
              "dart_analyze_packages_product_registry": "dart analyze",
              "dart_analyze_packages_store_contract_tests": "dart analyze",
              "dart_analyze_packages_control_plane_client": "dart analyze",
              "dart_analyze_packages_design_governance": "dart analyze",
              "dart_analyze_apps_server": "dart analyze",
              "dart_analyze_apps_control_plane": "dart analyze",
              "dart_test_packages_platform_contracts": "dart test",
              "dart_test_packages_workflow_engine": "dart test",
              "dart_test_packages_workflow_store": "dart test",
              "dart_test_packages_agent_runtime": "dart test",
              "dart_test_packages_worker_protocol": "dart test",
              "dart_test_packages_qa_orchestration": "dart test",
              "dart_test_packages_deployment_protocol": "dart test",
              "dart_test_packages_execution_coordinator": "dart test",
              "dart_test_packages_worker_runtime": "dart test",
              "dart_test_packages_scheduler": "dart test",
              "dart_test_packages_product_registry": "dart test",
              "dart_test_packages_store_contract_tests": "dart test",
              "dart_test_packages_design_governance": "dart test",
              "server_unit_tests_runner": "dart run tool/run_unit_tests.dart",
              "flutter_test_apps_control_plane": "flutter test"
            },
            "requireStatus": "passed",
            "commandMatchIsExact": true
          }
        },
        {
          "gateId": "feature-review-bound-to-revision",
          "type": "revision-identity-match",
          "required": true,
          "config": {
            "evidenceTypes": [
              "review_verdict",
              "committed_revision"
            ],
            "reviewedRevisionField": "endingRevision",
            "producedRevisionField": "producedRevision",
            "requireStringEquality": true,
            "nullRevisionIsFailure": true
          }
        }
      ]
    },
    "deploymentContract": {
      "promotionPath": [
        "staging",
        "production"
      ],
      "approvalGates": []
    }
  },
  "metadata": {
    "authoredFor": "human decision 7a1c9f34 (REGISTER_QA_CONTRACT_AND_BACKFILL)",
    "persistenceScope": "ONLY contracts.qaContract and manifestVersion are persisted, by ControlPlaneService._persistDeclaredQAContract (apps/server/lib/src/services/control_plane_service.dart:2300). capabilities, environments, workItemCategories, designContract and deploymentContract are REQUIRED BY ProductManifest.fromJson and are NOT written anywhere. They are recorded here because the wire type has no smaller shape, not because this file changes platform behaviour.",
    "inertFields": {
      "createdAt": "Type-required, not persisted. Carries no assertion about when anything happened.",
      "updatedAt": "Type-required, not persisted. Carries no assertion about when anything happened.",
      "designContract.reviewers": "Empty because no reviewer identity is this file's to invent. It is not persisted, so the empty list asserts nothing.",
      "deploymentContract.approvalGates": "Empty because promotion to production is human-authorised by policy, not by a recorded approver list. It is not persisted.",
      "workItemCategories": "feature is the only category any intake path on this product actually files (triage, design remediation and feature intake all create WorkItemCategory.feature). It is not persisted."
    },
    "gateType": "triage-classification-structure is reused deliberately from qa_orchestration's structuredClassificationAdmitted (packages/qa_orchestration/lib/src/lane_g_triage_qa_contract.dart:172). Both gates make the SAME assertion about the SAME document - the terminal AgentResult's structuredResult as persisted in agent_result.structuredResultJson - so an evaluator registered once for that type evaluates both. A new type name would need a second evaluator for one assertion.",
    "evidenceTypes": "triage_structured_result, matching structuredClassificationAdmitted.evidenceTypes. A declared gate has to carry it in config because QAGateSpec has no evidenceTypes field, while the derived QAGateDefinition has one; ProductQAContractProvisioner reads it back out of config (declaredGateEvidenceTypesConfigKey). Same value on both sides, so one evaluator serves both gates against one evidence type.",
    "evaluatorRuntime": "present. The gate type 'triage-classification-structure' has a REGISTERED evaluator (TriageClassificationAdmittedGate, packages/qa_orchestration/lib/src/gates/evaluators/triage_classification_admitted_gate.dart), so QAOrchestration.evaluate no longer answers QAGateStatus.notExecuted for it, and a PRODUCTION drain (apps/server/lib/src/qa/qa_drain.dart) evaluates a work item's contract once a human has approved its review. The DERIVED contract therefore no longer carries the 'evaluatorRuntime': 'absent' marker: design-revision.md:1016 requires that marker only until slice 3c is in place AND the gate's type has an evaluator, and both conditions now hold. The gate is EVALUATED, not merely DECLARED."
  },
