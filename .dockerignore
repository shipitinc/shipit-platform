# Docker ignore file
# Exclude everything by default
*

# Include apps directory structure
!apps/
!apps/control_plane/
!apps/control_plane/build/
!apps/control_plane/build/web
!apps/control_plane/build/web/**

# Include docker directory
!docker/
!docker/**

# Include necessary files for server build
!apps/server/
!apps/server/**

# Include packages for local development
!packages/
!packages/**

# Include the workspace manifests. `docker/Dockerfile.server` COPYs these at line 15
# and rewrites pubspec.yaml to drop the control_plane member before `dart pub get`.
# Without these the server image build fails with
# `failed to calculate checksum ... "/pubspec.yaml": not found`.
!pubspec.yaml
!pubspec.lock

# Exclude git and IDE files
.git
.gitignore
.idea
.vscode
.DS_Store
*.swp
*.swo