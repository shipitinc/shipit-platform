# Pinned to the version in .fvmrc. `cirrusci/flutter:latest` drifted independently
# of the repo's own FVM pin, which is how a golden-pixel build ends up running on
# a different SDK than the one the tests ran on.
#
# For LOCAL DEVELOPMENT: This Dockerfile copies pre-built web artifacts from the
# host machine (apps/control_plane/build/web) to avoid network issues with
# Cloudflare WARP or other VPNs blocking storage.googleapis.com.
#
# For CI/CD: Override with a build stage that runs `flutter build web --release`
# inside the container (requires network access to storage.googleapis.com).

FROM nginx:alpine

# Install gettext for envsubst
RUN apk add --no-cache gettext

# Copy pre-built web artifacts from host (built locally with `flutter build web --release`)
COPY apps/control_plane/build/web /usr/share/nginx/html

# Copy runtime configuration templates
COPY docker/config.js.template /usr/share/nginx/html/config.js.template
COPY docker/nginx.conf.template /etc/nginx/conf.d/default.conf.template
COPY docker/entrypoint.client.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 8081

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]