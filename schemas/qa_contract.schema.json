{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/qa_contract.schema.json",
  "title": "QAContract",
  "description": "Defines required QA gates and evidence types per work item category. Published by AEF, enforced by ShipIt Platform QA Orchestration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "workItemCategory", "gates", "version", "createdAt"],
  "properties": {
    "contractId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this QA contract"
    },
    "workItemCategory": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor", "docs", "chore", "security", "performance"],
      "description": "Work item category this contract applies to"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Contract version for evolution tracking"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "type", "required", "config", "evidenceTypes"],
        "properties": {
          "gateId": {
            "type": "string",
            "description": "Unique gate identifier within contract"
          },
          "type": {
            "type": "string",
            "enum": [
              "static-analysis",
              "unit-tests",
              "integration-tests",
              "security-scan",
              "performance",
              "accessibility",
              "dependency-review",
              "license-compliance",
              "custom"
            ]
          },
          "required": {
            "type": "boolean",
            "description": "Whether this gate must pass for QA to pass"
          },
          "config": {
            "type": "object",
            "description": "Gate-specific configuration (thresholds, tools, etc.)"
          },
          "evidenceTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "test-report",
                "coverage-report",
                "static-analysis-report",
                "security-scan-report",
                "performance-metrics",
                "accessibility-report",
                "sbom",
                "dependency-report",
                "custom"
              ]
            },
            "minItems": 1,
            "description": "Types of evidence this gate produces/requires"
          },
          "workerCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["linux", "macos", "docker", "flutter", "web", "android", "ios", "xcode", "gpu"]
            },
            "description": "Worker capabilities required to run this gate"
          }
        }
      },
      "minItems": 1,
      "description": "QA gates required for this work item category"
    },
    "passCriteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allRequiredGatesMustPass": {
          "type": "boolean",
          "default": true
        },
        "optionalGateFailuresAllowed": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "waiverRequiresHumanDecision": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Criteria for overall QA pass/fail. Enforcement follows AEF QA_GOVERNANCE.md 'Evidence Rows & Determinations': a SKIPPED-by-authority required gate is respected (not a FAIL), a NOT_EXECUTED required gate is not silently passed or silently blocking (a determination path is surfaced), and a permanently-unrunnable REQUIRED row must be formally determined rather than left latent."
    },
    "evidenceRows": {
      "type": "array",
      "items": { "$ref": "#/definitions/QAEvidenceRow" },
      "description": "First-class E_* evidence rows declared by the QA Architect at contract time, each binding a contract-mandated evidence requirement to the feature-specific artifact(s), run params, and prerequisites that will satisfy it."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of contract creation"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "metadata": {
      "type": "object",
      "description": "Extensible metadata"
    }
  },
  "definitions": {
    "QAEvidenceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "requirement", "testMethod", "contractDetermination"],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^E-[0-9]+$",
          "description": "E_* row identifier, unique within the contract (e.g., E-01)"
        },
        "title": {
          "type": "string",
          "description": "Human-readable title of the requirement the row evidences"
        },
        "scope": {
          "type": "string",
          "description": "Scope of the evidenced requirement"
        },
        "requirement": {
          "type": "string",
          "enum": ["required", "optional", "not_applicable"],
          "description": "Whether this evidence row is required, optional, or not applicable"
        },
        "testMethod": {
          "type": "string",
          "enum": ["automated", "visual", "human", "combined"],
          "description": "Execution method for the row"
        },
        "artifactRef": {
          "type": "string",
          "description": "Feature-specific artifact/file/URL that satisfies this row"
        },
        "params": {
          "type": "string",
          "description": "Run parameters the artifact needs (e.g., --dart-define=E2E_VERIFICATION_CODE)"
        },
        "prerequisites": {
          "type": "string",
          "description": "Runnable-lane facts the row depends on (CI device job, headless device, services, credentials, platform)"
        },
        "traceabilityRefs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Requirements/design refs the row evidences"
        },
        "contractDetermination": {
          "type": "string",
          "enum": ["expected_to_execute", "contingent", "skipped_by_contract"],
          "description": "Contract-time determination declared at freeze"
        },
        "determinationReasons": {
          "type": "string",
          "description": "Mandatory prose when contractDetermination is not expected_to_execute"
        }
      },
      "description": "A contract-mandated E_* evidence row binding a requirement to the feature-specific artifact, params, and prerequisites that will satisfy it. A REQUIRED row must reach EXECUTED or a formal SKIPPED; an OPTIONAL/NOT_APPLICABLE row may rest at READY_NOT_EXECUTED."
    }
  }
}