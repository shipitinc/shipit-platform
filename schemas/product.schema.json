{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/product.schema.json",
  "title": "Product",
  "description": "Registered Product \u2014 the canonical, durable, independently governed software unit (checkpoint 006). Registry/identity record only; ProductManifest is the definition/configuration payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productId",
    "name",
    "state",
    "createdAt",
    "updatedAt",
    "version"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "manifestVersion": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "Per-product lifecycle. registered..archived are canonical; draft/active/deprecated are parse-only legacy values retained so existing rows deserialise (ADR 0018).",
      "enum": [
        "registered",
        "baseline_pending",
        "baseline_blocked",
        "baseline_review",
        "governed",
        "paused",
        "archived",
        "draft",
        "active",
        "deprecated"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
