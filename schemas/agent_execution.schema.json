{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/agent_execution.schema.json",
  "title": "AgentExecution",
  "description": "Durable record of one agent execution, distinct from the WorkItem and from any runtime session. The runtime/session identifier lives here, never on the WorkItem.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executionId",
    "workItemId",
    "requestId",
    "runtimeTypeId",
    "role",
    "status",
    "workspace",
    "version"
  ],
  "properties": {
    "executionId": { "type": "string", "format": "uuid" },
    "workItemId": { "type": "string", "format": "uuid" },
    "requestId": { "type": "string", "format": "uuid" },
    "runtimeTypeId": {
      "type": "string",
      "description": "Provider-neutral runtime identifier, e.g. 'opencode'"
    },
    "role": {
      "type": "string",
      "enum": ["IMPLEMENTER", "ENGINEERING_REVIEWER", "DESIGN_AGENT", "DESIGN_REVIEWER", "QA_ARCHITECT", "QA_EXECUTOR", "RELEASE_ENGINEER", "DEPLOYMENT_AUTHORITY", "CORRECTION_IMPLEMENTER", "FOCUSED_REVIEWER", "INTEGRATOR"]
    },
    "status": {
      "type": "string",
      "enum": ["starting", "running", "completed", "failed", "cancelled", "interrupted", "orphaned"]
    },
    "workspace": { "$ref": "#/definitions/workspace" },
    "sessionId": { "type": "string" },
    "resultId": { "type": "string", "format": "uuid" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "reason": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "version": { "type": "integer", "minimum": 1 }
  },
  "definitions": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "path"],
      "properties": {
        "workspaceId": { "type": "string" },
        "path": { "type": "string" },
        "startingRevision": { "type": "string" },
        "allowedPaths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}