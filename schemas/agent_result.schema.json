{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/agent_result.schema.json",
  "title": "AgentResult",
  "description": "Structured final result from an agent session. Only this is persisted; agent conversations are ephemeral.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultId", "sessionId", "workItemId", "status", "artifacts", "diagnostics", "structuredResult", "completedAt"],
  "properties": {
    "resultId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this agent result"
    },
    "executionId": {
      "type": "string",
      "format": "uuid",
      "description": "AgentExecutionRequest.executionId this result belongs to"
    },
    "role": {
      "type": "string",
      "enum": ["IMPLEMENTER", "ENGINEERING_REVIEWER", "DESIGN_AGENT", "DESIGN_REVIEWER", "QA_ARCHITECT", "QA_EXECUTOR", "RELEASE_ENGINEER", "DEPLOYMENT_AUTHORITY", "CORRECTION_IMPLEMENTER", "FOCUSED_REVIEWER", "INTEGRATOR"],
      "description": "AEF role granted by the execution request. Stamped by the coordinator, never asserted by the agent."
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation"],
        "properties": {
          "path": { "type": "string" },
          "operation": { "type": "string", "enum": ["modified", "added", "deleted", "renamed"] },
          "beforeSha": { "type": "string" },
          "afterSha": { "type": "string" }
        }
      },
      "description": "Files the agent reports changing"
    },
    "claimedChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkName", "status", "evidenceKind"],
        "properties": {
          "checkName": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed"] },
          "evidenceKind": { "type": "string", "const": "agent_claimed_evidence" },
          "command": { "type": "string" },
          "detail": { "type": "string" }
        }
      },
      "description": "Validation the AGENT claims. Distinct from platform-verified evidence."
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "description": "Agent session that produced this result"
    },
    "workItemId": {
      "type": "string",
      "format": "uuid",
      "description": "Work item this result belongs to"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "cancelled", "partial"],
      "description": "Final status of the agent session"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "type", "path", "sha256", "sizeBytes", "mediaType"],
        "properties": {
          "artifactId": { "type": "string", "format": "uuid" },
          "type": {
            "type": "string",
            "enum": ["source-code", "test-code", "config", "documentation", "script", "binary", "other"]
          },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "description": "Files produced by the agent"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "durationMs", "toolCalls", "errors", "warnings"],
      "properties": {
        "exitCode": { "type": "integer" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "severity"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "severity": { "type": "string", "enum": ["error", "warning", "info"] },
              "location": { "type": "string" },
              "suggestion": { "type": "string" }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "location": { "type": "string" }
            }
          }
        },
        "resourceUsage": {
          "type": "object",
          "properties": {
            "peakMemoryMb": { "type": "integer" },
            "cpuSeconds": { "type": "number" },
            "networkBytes": { "type": "integer" }
          }
        }
      },
      "description": "Execution diagnostics and metrics"
    },
    "structuredResult": {
      "type": "object",
      "description": "Structured output from agent (e.g., test results, analysis findings, generated code summary). Schema defined per work item category.",
      "additionalProperties": true
    },
    "summary": {
      "type": "string",
      "maxLength": 2000,
      "description": "Human-readable summary of what the agent accomplished"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when agent session completed"
    },
    "metadata": {
      "type": "object",
      "description": "Provider-specific metadata (e.g., OpenCode session info, model used)"
    }
  }
}