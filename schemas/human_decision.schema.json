{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/human_decision.schema.json",
  "title": "HumanDecision",
  "description": "Durable, auditable human decision. Created as pending and resolved later by a human. Must survive process restarts. Stored in PostgreSQL via Serverpod.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "workItemId", "decisionType", "updatedAt"],
  "properties": {
    "decisionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this decision"
    },
    "workItemId": {
      "type": "string",
      "format": "uuid",
      "description": "Work item this decision applies to"
    },
    "decisionType": {
      "type": "string",
      "enum": [
        "design_approval",
        "design_rejection",
        "qa_waiver",
        "qa_rework",
        "deployment_approval",
        "deployment_rejection",
        "rollback_approval",
        "escalation",
        "policy_exception",
        "product_decision",
        "architecture_decision",
        "engineering_review",
        "human_qa_approval",
        "destructive_migration_approval",
        "security_decision",
        "infrastructure_decision",
        "other_consequential"
      ],
      "description": "Type of decision for routing and policy evaluation"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "resolved", "escalated", "deferred", "cancelled"],
      "default": "pending",
      "description": "Lifecycle status of the decision. Only a resolved decision carries resolution fields."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "The question presented to the human"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowState", "availableOptions"],
      "properties": {
        "workflowState": { "type": "string" },
        "availableOptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "relatedDecisions": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        }
      },
      "description": "Context at time of decision for audit trail"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "label"],
        "properties": {
          "optionId": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "recommended": {
            "type": "boolean",
            "default": false,
            "description": "The orchestration recommends this option"
          }
        }
      },
      "description": "Enumeration of resolution options presented to the human"
    },
    "recommendation": {
      "type": "string",
      "description": "optionId the orchestrator recommends"
    },
    "blocking": {
      "type": "boolean",
      "default": true,
      "description": "Whether the workflow is blocked until this decision is resolved"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the decision was requested"
    },
    "expiration": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiration timestamp (for time-limited approvals)"
    },
    "decider": {
      "type": "string",
      "format": "email",
      "description": "Email of the human resolving the decision"
    },
    "choice": {
      "type": "string",
      "enum": ["approve", "reject", "waive", "rework", "cancel", "defer"],
      "description": "The resolution choice."
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Human-readable justification for the decision"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when decision was resolved"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "publicKey", "signature", "signedAt"],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519",
          "description": "Signature algorithm"
        },
        "publicKey": {
          "type": "string",
          "description": "Base64-encoded Ed25519 public key"
        },
        "signature": {
          "type": "string",
          "description": "Base64-encoded signature over decision payload"
        },
        "signedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of signing"
        }
      },
      "description": "Cryptographic signature for non-repudiation"
    },
    "resolvedOptionId": {
      "type": "string",
      "description": "The optionId the human chose when resolving"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last update"
    },
    "metadata": {
      "type": "object",
      "description": "Extensible metadata (e.g., Slack message link, meeting notes)"
    }
  },
  "if": {
    "properties": {
      "status": { "const": "resolved" }
    },
    "required": ["status"]
  },
  "then": {
    "required": ["decider", "choice", "rationale", "timestamp", "signature"],
    "description": "A resolved decision must carry the full resolution payload"
  }
}