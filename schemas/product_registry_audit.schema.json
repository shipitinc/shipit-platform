{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/product_registry_audit.schema.json",
  "title": "ProductRegistryAudit",
  "description": "Append-only audit log for all product registry mutations. Every write operation (create/update/transition) records an entry here. Never deleted, never updated — only inserted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auditId",
    "productId",
    "entityType",
    "entityId",
    "action",
    "timestamp"
  ],
  "properties": {
    "auditId": { "type": "string", "minLength": 1 },
    "productId": { "type": "string", "minLength": 1 },
    "entityType": {
      "type": "string",
      "enum": [
        "product",
        "repository_reference",
        "product_baseline",
        "baseline_fact",
        "clarification_request",
        "onboarding_record",
        "product_credential",
        "standing_policy"
      ]
    },
    "entityId": { "type": "string", "minLength": 1 },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "transition",
        "accept",
        "reject",
        "revoke",
        "rotate",
        "confirm_host",
        "check_credential",
        "propose_baseline",
        "verify_baseline",
        "request_approval",
        "resolve_approval",
        "require_clarification",
        "answer_clarification",
        "request_lifecycle",
        "resolve_lifecycle",
        "request_policy",
        "resolve_policy",
        "revoke_policy"
      ]
    },
    "beforeJson": { "type": "string" },
    "afterJson": { "type": "string" },
    "actor": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}