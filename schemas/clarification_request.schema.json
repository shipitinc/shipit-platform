{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/clarification_request.schema.json",
  "title": "ClarificationRequest",
  "description": "Durable clarification: onboarding stopped because material information is unknown. The stop survives process restart; a new execution resumes the same Product/onboarding/baseline lineage after the human answer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clarificationId",
    "productId",
    "onboardingId",
    "section",
    "question",
    "status",
    "createdAt"
  ],
  "properties": {
    "clarificationId": { "type": "string", "minLength": 1 },
    "productId": { "type": "string", "minLength": 1 },
    "onboardingId": { "type": "string", "minLength": 1 },
    "section": {
      "type": "string",
      "enum": [
        "repository",
        "tech_stack",
        "architecture",
        "design",
        "qa",
        "ci_cd",
        "environments",
        "data",
        "deployment",
        "governance",
        "known_gaps"
      ]
    },
    "question": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["needs_answer", "answered"] },
    "answer": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "answeredAt": { "type": "string", "format": "date-time" },
    "answeredBy": { "type": "string" }
  }
}