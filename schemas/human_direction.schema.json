{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/human_direction.schema.json",
  "title": "HumanDirection",
  "description": "Durable human direction to agents. Categorized by intent, target-scoped, with lifecycle status. Created by operators, consumed by workers in the next bounded job — never injected mid-execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["directionId", "directionType", "target", "status", "payload", "createdAt", "updatedAt"],
  "properties": {
    "directionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this direction"
    },
    "directionType": {
      "type": "string",
      "enum": [
        "question",
        "directive",
        "work_intake",
        "bug_report",
        "clarification"
      ],
      "description": "Category of direction determining how workers handle it"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetType"],
      "properties": {
        "targetType": {
          "type": "string",
          "enum": ["product", "work_item", "run", "execution", "job", "none"],
          "description": "What this direction applies to"
        },
        "targetId": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the target entity (required unless targetType is 'none')"
        }
      },
      "description": "Scope of this direction"
    },
    "status": {
      "type": "string",
      "enum": ["created", "acked", "working", "completed", "rejected", "superseded"],
      "default": "created",
      "description": "Lifecycle status of the direction"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Brief title/summary of the direction"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "Full description of what is being asked or directed"
        },
        "contextJson": {
          "type": "string",
          "description": "Optional structured context as JSON string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactId", "artifactType"],
            "properties": {
              "artifactId": { "type": "string", "format": "uuid" },
              "artifactType": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "description": "References to supporting artifacts"
        }
      },
      "description": "The content of the direction"
    },
    "createdBy": {
      "type": "string",
      "format": "email",
      "description": "Email of the human who created this direction"
    },
    "assignedTo": {
      "type": "string",
      "format": "email",
      "description": "Optional: specific worker/role assigned"
    },
    "ackedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the direction was acknowledged"
    },
    "ackedBy": {
      "type": "string",
      "format": "email",
      "description": "Who acknowledged the direction"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When work on this direction began"
    },
    "startedBy": {
      "type": "string",
      "format": "email",
      "description": "Who started working on the direction"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the direction was completed"
    },
    "completedBy": {
      "type": "string",
      "format": "email",
      "description": "Who completed the direction"
    },
    "completionSummary": {
      "type": "string",
      "maxLength": 5000,
      "description": "Summary of what was done to complete the direction"
    },
    "rejectedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the direction was rejected"
    },
    "rejectedBy": {
      "type": "string",
      "format": "email",
      "description": "Who rejected the direction"
    },
    "rejectionReason": {
      "type": "string",
      "maxLength": 5000,
      "description": "Reason for rejection"
    },
    "supersededAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this direction was superseded by another"
    },
    "supersededByDirectionId": {
      "type": "string",
      "format": "uuid",
      "description": "The direction that superseded this one"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the direction was created"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last update"
    },
    "metadata": {
      "type": "object",
      "description": "Extensible metadata"
    }
  },
  "if": {
    "properties": {
      "status": { "const": "acked" }
    },
    "required": ["status"]
  },
  "then": {
    "required": ["ackedAt", "ackedBy"],
    "description": "An acknowledged direction must carry acknowledgment info"
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "working" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["ackedAt", "ackedBy", "startedAt", "startedBy"],
        "description": "A working direction must carry acknowledgment and start info"
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "completed" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["ackedAt", "ackedBy", "startedAt", "startedBy", "completedAt", "completedBy", "completionSummary"],
        "description": "A completed direction must carry full lifecycle info"
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "rejected" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["rejectedAt", "rejectedBy", "rejectionReason"],
        "description": "A rejected direction must carry rejection info"
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "superseded" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["supersededAt", "supersededByDirectionId"],
        "description": "A superseded direction must reference the superseding direction"
      }
    }
  ]
}