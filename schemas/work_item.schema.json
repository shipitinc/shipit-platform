{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shipit.platform/schemas/work_item.schema.json",
  "title": "WorkItem",
  "description": "A unit of work governed by the ShipIt workflow engine. State changes are legal only via the validated transition table.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workItemId", "productId", "category", "title", "state", "createdAt", "updatedAt"],
  "properties": {
    "workItemId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this work item"
    },
    "productId": {
      "type": "string",
      "format": "uuid",
      "description": "Product this work item belongs to"
    },
    "category": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor", "docs", "chore", "security", "performance"],
      "description": "Category determines the applicable contracts"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Short human-readable title"
    },
    "description": {
      "type": "string",
      "description": "Optional details"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "design_in_review",
        "design_approved",
        "design_rejected",
        "agent_executing",
        "agent_completed",
        "agent_failed",
        "qa_in_progress",
        "qa_passed",
        "qa_failed",
        "deploying",
        "deployed",
        "deployment_failed",
        "done"
      ],
      "description": "Current state in the work item state machine (see runtime-flow.md)"
    },
    "designContractId": {
      "type": "string",
      "format": "uuid",
      "description": "Design contract governing this work item"
    },
    "agentSessionId": {
      "type": "string",
      "format": "uuid",
      "description": "Agent session that last executed this work item"
    },
    "qaContractId": {
      "type": "string",
      "format": "uuid",
      "description": "QA contract governing this work item"
    },
    "metadata": {
      "type": "object",
      "description": "Extensible metadata, never workflow state"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the work item was created"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last update"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the work item reached done"
    }
  }
}