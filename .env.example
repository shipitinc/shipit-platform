# SHIP IT Local Deployment Environment Variables
# Copy this file to .env and customize as needed
# DO NOT COMMIT .env - it's in .gitignore

# =============================================================================
# Port Configuration
# =============================================================================
# Offset all published ports to avoid conflicts with other services
# Set to 0 for defaults (5432, 8080, 8081)
# Example: PORT_OFFSET=1000 maps to 15432, 10880, 10881
PORT_OFFSET=0

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_DB=shipit
POSTGRES_USER=shipit
POSTGRES_PASSWORD=shipit

# =============================================================================
# Server (Serverpod)
# =============================================================================
# API server port (inside container)
SERVERPOD_API_SERVER_PORT=8080

# Triage repository paths (volumes mounted in compose)
SHIPIT_TRIAGE_REPOSITORY_PATH=/triage-repo
# Global cap on CONCURRENT agent executions. FAILS CLOSED: unset means the
# server refuses to boot rather than running unbounded (host crash 2026-10-10).
SHIPIT_DISPATCH_MAX_CONCURRENT_AGENTS=2
SHIPIT_TRIAGE_WORKSPACE_ROOT=/triage-workspaces

# =============================================================================
# Client (nginx + Flutter web)
# =============================================================================
# Base URL for API calls from the browser
# In compose.qa.yaml: http://localhost:8081/api/ (proxied to server:8080)
# In compose.e2e.yaml: http://client:8081/api/ (internal DNS)
# For standalone client against host server: http://host.docker.internal:8080/api/
CONTROL_PLANE_API=http://localhost:8081/api/

# Upstream target for nginx /api/ proxy_pass
# In compose.qa.yaml: server:8080 (internal Docker DNS)
# In compose.e2e.yaml: server:8080 (internal Docker DNS)
# For standalone client against host server: host.docker.internal:8080
API_UPSTREAM=server:8080

# =============================================================================
# Worker Profile (opencode container)
# =============================================================================
# Enable with: docker compose --profile workers up -d worker-linux
WORKER_POOL=linux
SERVERPOD_API_URL=http://server:8080

# =============================================================================
# Provider Credentials (agent runtime / opencode)
# =============================================================================
# OpenRouter API key for the opencode agent runtime's PAID tier. opencode
# resolves provider credentials from its own environment conventions;
# OPENROUTER_API_KEY is the name it honors for the `openrouter` provider.
# OPENCODE_OPENROUTER_API_KEY is the platform-prefixed twin
# (OPENCODE_<PROVIDER>_API_KEY); leave it empty and it mirrors the canonical
# value.
#
# FOR THE QA STACK (docker/compose.qa.yaml): set these in docker/.env, NOT in
# this file. The server service interpolates "${OPENROUTER_API_KEY:-}" from
# the compose project-directory env file (docker/.env), and `environment:`
# overrides `env_file:` per key — a value placed here is silently shadowed to
# empty. docker/.env.example documents the full set.
#
# FOR PRODUCTION: the value enters the environment's secret management and is
# injected as a process environment variable — referenced by NAME only, never
# a committed file (AGENTS.md §13a).
#
# Empty = no OpenRouter credential; the free opencode/zen tier keeps working.
OPENROUTER_API_KEY=
OPENCODE_OPENROUTER_API_KEY=

# =============================================================================
# Development Overrides (uncomment to use)
# =============================================================================
# Use local Flutter SDK instead of pinned version (requires Flutter in PATH)
# FLUTTER_SDK_PATH=/path/to/flutter

# Enable debug logging
# LOG_LEVEL=debug

# =============================================================================
# CI/CD (Cloud Build) - Only for image building, no deployment
# =============================================================================
# Artifact Registry repository (format: region-docker.pkg.dev/project/repo)
# _ARTIFACTS_REPO=us-central1-docker.pkg.dev/my-project/shipit
# _REGION=us-central1